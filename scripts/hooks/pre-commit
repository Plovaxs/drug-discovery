#!/usr/bin/env bash
# Pre-commit hook: runs this project's test suites before allowing a commit.
#
# Why a hook rather than trusting ourselves to remember: the two things these suites protect -- the
# sequence-identity leakage filter and the pocket-extraction normalisation -- have each broken once
# already, and in both cases the breakage was SILENT. A leakage regression does not raise; it just
# produces a model whose test score is quietly inflated. By the time that is noticed, runs have been
# burned on it. The hook exists so the check is not a thing we decide to run.
#
# Deliberately NOT in this hook: anything that needs the GPU, the network, or more than a few seconds.
# A slow hook gets bypassed, and a bypassed hook protects nothing. Current runtime ~10 s.
#
# Install:   bash scripts/hooks/install.sh
# Bypass:    git commit --no-verify     (legitimate for a WIP commit; the suites still run in CI/by hand)

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

# The project lives in a conda env that a hook's shell has not activated, so the interpreter is named
# explicitly. Falling back to whatever `python3` is on PATH would run the suites against the wrong
# dependency set and produce failures that say nothing about the commit.
PY="$HOME/miniconda3/envs/drugdisc/bin/python"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3 || true)"
fi
if [ -z "$PY" ]; then
  echo "pre-commit: no usable python interpreter found; skipping tests (commit allowed)" >&2
  exit 0
fi

echo "pre-commit: running project test suites..."
PYTHONPATH="$REPO_ROOT" "$PY" guidance/run_tests.py --quiet
rc=$?

if [ $rc -ne 0 ]; then
  cat >&2 <<'MSG'

pre-commit: TESTS FAILED -- commit aborted.

Fix the failure, or if this commit is intentionally work-in-progress:
    git commit --no-verify

Do not bypass a failure in test_leakage_guard.py without reading it. Those assertions are the
train/val/test separation the thesis's results depend on; a failure there means the data pool on
disk no longer matches what the leakage audit certified.
MSG
  exit $rc
fi

echo "pre-commit: all suites green."
exit 0
